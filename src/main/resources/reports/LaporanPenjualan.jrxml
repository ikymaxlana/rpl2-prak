<jasperReport name="LaporanPenjualan" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5e7ba963-01de-4a15-8f7a-4b6a46b4ba2e">
	<query language="sql"><![CDATA[SELECT t.id_transaksi, t.tanggal, t.total,
       COALESCE(SUM(d.jumlah), 0) AS jumlah,
       COALESCE(GROUP_CONCAT(CONCAT(b.nama_barang, ' (', d.jumlah, ')')
                ORDER BY b.nama_barang SEPARATOR ', '), '-') AS rincian
FROM transaksi t
LEFT JOIN detail_transaksi d ON t.id_transaksi = d.id_transaksi
LEFT JOIN barang b ON d.id_barang = b.id_barang
GROUP BY t.id_transaksi, t.tanggal, t.total
ORDER BY t.tanggal DESC, t.id_transaksi DESC]]></query>
	<field name="id_transaksi" class="java.lang.Integer"/>
	<field name="tanggal" class="java.sql.Timestamp"/>
	<field name="total" class="java.lang.Double"/>
	<field name="jumlah" class="java.lang.Integer"/>
	<field name="rincian" class="java.lang.String"/>
	<variable name="TOTAL_SEMUA" class="java.lang.Double" calculation="Sum">
		<expression><![CDATA[$F{total}]]></expression>
	</variable>
